# Production Dockerfile for Laravel Backend (Railway)
# Multi-stage build for optimized production image

# ============================================
# Stage 1: Composer Dependencies
# ============================================
FROM php:8.3-cli-alpine AS composer-stage

# Pin Composer's execution environment to PHP 8.3. The moving composer:2
# image currently ships PHP 8.5, which is incompatible with this lockfile.
RUN apk add --no-cache git unzip libzip-dev \
    && docker-php-ext-install zip
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Copy composer files
COPY composer.json composer.lock ./

# Install production dependencies only
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-interaction \
    --optimize-autoloader \
    --no-progress

# ============================================
# Stage 2: Production Image
# ============================================
FROM php:8.3-fpm-alpine

# Install system dependencies
RUN apk add --no-cache \
    nginx \
    supervisor \
    git \
    unzip \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    icu-dev \
    libxml2-dev \
    oniguruma-dev \
    gettext \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo_mysql \
        bcmath \
        zip \
        intl \
        mbstring \
        xml \
        gd \
        opcache \
    && rm -rf /var/cache/apk/*

# Copy PHP configuration
COPY docker/php.ini /usr/local/etc/php/conf.d/custom.ini

# Copy Nginx configuration
COPY docker/nginx.conf /etc/nginx/nginx.conf.template

# Copy Supervisor configuration
COPY docker/supervisord.conf /etc/supervisord.conf

# Set working directory
WORKDIR /var/www/html

# Copy application files
COPY . .

# Copy vendor from composer stage
COPY --from=composer-stage /app/vendor ./vendor

RUN php artisan package:discover --ansi

# Set permissions
RUN mkdir -p storage/framework/{sessions,views,cache} \
    && mkdir -p bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Create nginx run directory
RUN mkdir -p /var/run/nginx

# Expose port (Railway will use this)
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT}/health || exit 1

# Start supervisor (manages PHP-FPM and Nginx)
CMD ["sh", "-c", "mkdir -p storage/framework/sessions storage/framework/views storage/framework/cache bootstrap/cache && chown -R www-data:www-data storage bootstrap/cache && (php artisan storage:link --force || true) && php artisan migrate --force --no-interaction && envsubst '$PORT' < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf && exec /usr/bin/supervisord -c /etc/supervisord.conf"]
