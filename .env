# Shared local addresses for `docker compose`.
# Change the host or ports here, then restart the affected containers.

# Database Configuration
DB_ROOT_PASSWORD=RootPass123
DB_DATABASE=business_center

LOCAL_HOST=localhost
MAIN_BACKEND_PORT=8000
STAFF_ID_BACKEND_PORT=8001
PRINT_BACKEND_PORT=8002
STICKER_BACKEND_PORT=8003
ACCOUNT_BACKEND_PORT=8004
ACCOUNT_NODE_API_PORT=3002
# Used by student_account_module/api-server when it is started outside Compose.
PORT=${ACCOUNT_NODE_API_PORT}

MAIN_FRONTEND_PORT=5173
STAFF_ID_FRONTEND_PORT=5174
PRINT_FRONTEND_PORT=5175
STICKER_FRONTEND_PORT=5176
ACCOUNT_FRONTEND_PORT=5177

MAIN_BACKEND_URL=http://${LOCAL_HOST}:${MAIN_BACKEND_PORT}
STAFF_ID_BACKEND_URL=http://${LOCAL_HOST}:${STAFF_ID_BACKEND_PORT}
PRINT_BACKEND_URL=http://${LOCAL_HOST}:${PRINT_BACKEND_PORT}
STICKER_BACKEND_URL=http://${LOCAL_HOST}:${STICKER_BACKEND_PORT}
ACCOUNT_BACKEND_URL=http://${LOCAL_HOST}:${ACCOUNT_BACKEND_PORT}
ACCOUNT_NODE_API_URL=http://${LOCAL_HOST}:${ACCOUNT_NODE_API_PORT}

MAIN_API_URL=${MAIN_BACKEND_URL}/api
STAFF_ID_API_URL=${STAFF_ID_BACKEND_URL}/api
PRINT_API_URL=${PRINT_BACKEND_URL}/api/v1
PRINT_API_PROXY_TARGET=http://print-backend:8000
STICKER_API_URL=${STICKER_BACKEND_URL}/api
ACCOUNT_API_URL=${ACCOUNT_BACKEND_URL}/api

MAIN_FRONTEND_URL=http://${LOCAL_HOST}:${MAIN_FRONTEND_PORT}
STAFF_ID_FRONTEND_URL=http://${LOCAL_HOST}:${STAFF_ID_FRONTEND_PORT}
PRINT_FRONTEND_URL=http://${LOCAL_HOST}:${PRINT_FRONTEND_PORT}
STICKER_FRONTEND_URL=http://${LOCAL_HOST}:${STICKER_FRONTEND_PORT}
ACCOUNT_FRONTEND_URL=http://${LOCAL_HOST}:${ACCOUNT_FRONTEND_PORT}
ACCOUNT_REGISTER_URL=${ACCOUNT_FRONTEND_URL}/register

# Browser origins accepted by the Laravel APIs.
CORS_ALLOWED_ORIGINS=${MAIN_FRONTEND_URL},${STAFF_ID_FRONTEND_URL},${PRINT_FRONTEND_URL},${STICKER_FRONTEND_URL},${ACCOUNT_FRONTEND_URL}
