# Docker Environment Configuration

# Database
MYSQL_DATABASE=sticker_module
MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=sticker_user
MYSQL_PASSWORD=sticker_pass

# Backend
APP_NAME="Sticker Module"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
